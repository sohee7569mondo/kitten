"<!-- wp:html -->\n<!--\n  STELLA SAJU \u2014 \uc774\ubc88\uc8fc \ub760\ubcc4\uc6b4\uc138 (\ud398\uc774\uc9c0 ID 92)   BUILD: A2\n\n  \uc0c1\ub2e8 \uba54\ub274/\ud478\ud130\ub294 \ud14c\ub9c8 \ud15c\ud50c\ub9bf \ud30c\ud2b8\uc5d0 \uc788\uc2b5\ub2c8\ub2e4. \uc5ec\uae30\uc5d4 \ubcf8\ubb38\ub9cc \uc788\uc2b5\ub2c8\ub2e4.\n  \ubaa8\ub4e0 CSS \ub294 #ssp \uc548\uc73c\ub85c \ubb36\uc5ec \uc788\uc5b4 \ub2e4\ub978 \ud398\uc774\uc9c0\uc5d0 \uc601\ud5a5\uc744 \uc8fc\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\n-->\n<style>\n#ssp{\n  --void:#0D0A1A; --void-deep:#070512;\n  --nebula:#1C1533; --nebula-soft:#251C42;\n  --purple-glow:rgba(140,101,214,.35);\n  --gold:#D4AF6A; --gold-soft:#C9A66B; --gold-lite:#E8CD96;\n  --star:#F2ECE0; --ink-soft:rgba(242,236,224,.72); --ink-dim:rgba(242,236,224,.46);\n  --line:rgba(212,175,106,.18);\n\n  max-width:none !important; width:auto !important;\n  margin-left:calc(50% - 50vw) !important; margin-right:calc(50% - 50vw) !important;\n  padding:0 !important;\n  position:relative; z-index:0; overflow-x:clip;\n  color:var(--star); text-align:center;\n  font-family:'Noto Sans KR',-apple-system,'Apple SD Gothic Neo','Malgun Gothic',sans-serif;\n  font-weight:300; line-height:1.75; font-size:16px;\n  word-break:keep-all; overflow-wrap:break-word;\n}\n#ssp *{margin:0; padding:0; box-sizing:border-box;}\n#ssp h1,#ssp h2,#ssp h3{font-family:'Noto Serif KR',serif; color:var(--star); font-weight:700; letter-spacing:normal;}\n#ssp a{color:inherit; text-decoration:none;}\n#ssp button{font:inherit;}\n\n#ssp .ssp-stars{\n  position:fixed; inset:0; z-index:0; pointer-events:none;\n  background:\n    radial-gradient(1.5px 1.5px at 12% 18%, rgba(255,255,255,.9), transparent),\n    radial-gradient(1px 1px at 82% 12%, rgba(255,255,255,.7), transparent),\n    radial-gradient(1.5px 1.5px at 62% 62%, rgba(255,255,255,.8), transparent),\n    radial-gradient(1px 1px at 28% 78%, rgba(255,255,255,.6), transparent),\n    radial-gradient(1.5px 1.5px at 90% 52%, rgba(255,255,255,.7), transparent),\n    radial-gradient(1px 1px at 45% 32%, rgba(255,255,255,.5), transparent),\n    var(--void);\n}\n#ssp .ssp-inner{position:relative; z-index:1; max-width:1080px; margin:0 auto; padding:76px 24px 110px;}\n@media(max-width:700px){ #ssp .ssp-inner{padding:48px 18px 80px;} }\n\n#ssp .ssp-kicker{font-family:'IBM Plex Mono',monospace; font-size:.7rem; letter-spacing:.22em;\n  text-transform:uppercase; color:var(--gold); margin-bottom:16px;}\n#ssp h1{font-size:clamp(1.8rem,4.6vw,2.8rem); line-height:1.35;}\n#ssp .ssp-lead{margin:18px auto 0; color:var(--ink-soft); font-size:1rem; max-width:560px;}\n\n#ssp .upsell{margin:52px auto 0; max-width:560px; padding:28px 24px;\n  border:1px solid var(--line); border-radius:10px;}\n#ssp .upsell p{font-size:.92rem; color:var(--ink-soft);}\n#ssp .upsell a{display:inline-block; margin-top:14px; font-family:'IBM Plex Mono',monospace;\n  font-size:.82rem; color:var(--gold); border-bottom:1px solid var(--gold-soft); padding-bottom:3px;}\n#ssp .upsell a:hover{color:var(--gold-lite);}\n@media(prefers-reduced-motion:reduce){\n  #ssp *,#ssp *::before,#ssp *::after{animation:none !important; transition:none !important;}\n}\n\n#ssp .agrid{display:grid !important; grid-template-columns:repeat(4,1fr); gap:15px; margin-top:52px; text-align:left;}\n@media(max-width:960px){ #ssp .agrid{grid-template-columns:repeat(3,1fr);} }\n@media(max-width:680px){ #ssp .agrid{grid-template-columns:repeat(2,1fr);} }\n@media(max-width:430px){ #ssp .agrid{grid-template-columns:1fr;} }\n#ssp .acard{background:var(--nebula); border:1px solid var(--line); border-radius:12px; padding:24px 20px;\n  transition:border-color .25s ease, transform .25s ease;}\n#ssp .acard:hover{border-color:var(--gold-soft); transform:translateY(-3px);}\n#ssp .asym{width:54px; height:54px; border-radius:50%; display:flex; align-items:center; justify-content:center;\n  font-size:1.7rem; background:var(--void-deep); border:1px solid var(--line);}\n#ssp .aname{margin-top:14px; font-family:'Noto Serif KR',serif; font-weight:700; font-size:1.05rem;}\n#ssp .atext{margin-top:9px; font-size:.85rem; color:var(--ink-soft); line-height:1.8;}\n\n</style>\n\n<div id=\"ssp\">\n  <div class=\"ssp-stars\" aria-hidden=\"true\"></div>\n  <div class=\"ssp-inner\">\n\n    <div class=\"ssp-kicker\">Free &middot; \uc774\ubc88\uc8fc</div>\n    <h1>\uc774\ubc88\uc8fc \ub760\ubcc4\uc6b4\uc138</h1>\n    <p class=\"ssp-lead\">\uc5f4\ub450 \ub760, \uc774\ubc88\uc8fc \ud750\ub984\uc744 \uc9e7\uac8c \uc9da\uc5b4\ub4dc\ub824\uc694.</p>\n\n    <div class=\"agrid\">\n      <div class=\"acard\"><div class=\"asym\">\ud83d\udc2d</div><div class=\"aname\">\uc950\ub760</div><p class=\"atext\">\uc0c8\ub85c\uc6b4 \uc815\ubcf4\uac00 \ub4e4\uc5b4\uc624\ub294 \uc8fc\uc608\uc694. \uadc0 \uae30\uc6b8\uc774\uba74 \uc88b\uc740 \ud78c\ud2b8\uac00 \uc788\uc5b4\uc694.</p></div>\n      <div class=\"acard\"><div class=\"asym\">\ud83d\udc2e</div><div class=\"aname\">\uc18c\ub760</div><p class=\"atext\">\ubb35\ubb35\ud788 \ud574\uc628 \uc77c\uc774 \uc790\ub9ac \uc7a1\ub294 \uc2dc\uae30\uc608\uc694.</p></div>\n      <div class=\"acard\"><div class=\"asym\">\ud83d\udc2f</div><div class=\"aname\">\ubc94\ub760</div><p class=\"atext\">\uc774\ubc88\uc8fc \ud750\ub984\uc774 \uc88b\uc544\uc694. \ub098\uc11c\ub3c4 \uad1c\ucc2e\uc740 \ud0c0\uc774\ubc0d\uc785\ub2c8\ub2e4.</p></div>\n      <div class=\"acard\"><div class=\"asym\">\ud83d\udc30</div><div class=\"aname\">\ud1a0\ub07c\ub760</div><p class=\"atext\">\uc0ac\ub78c\uacfc\uc758 \uad00\uacc4\uc5d0\uc11c \uc88b\uc740 \uae30\uc6b4\uc774 \ub530\ub77c\uc694.</p></div>\n      <div class=\"acard\"><div class=\"asym\">\ud83d\udc32</div><div class=\"aname\">\uc6a9\ub760</div><p class=\"atext\">\ucd94\uc9c4\ub825\uc774 \uc0b4\uc544\ub098\ub294 \uc8fc. \ubbf8\ub904\ub454 \uc77c\uc744 \uc2dc\uc791\ud574\ubcf4\uc138\uc694.</p></div>\n      <div class=\"acard\"><div class=\"asym\">\ud83d\udc0d</div><div class=\"aname\">\ubc40\ub760</div><p class=\"atext\">\uc9c1\uac10\uc774 \ub0a0\uce74\ub85c\uc6cc\uc9c0\ub294 \uc2dc\uae30\uc608\uc694.</p></div>\n      <div class=\"acard\"><div class=\"asym\">\ud83d\udc34</div><div class=\"aname\">\ub9d0\ub760</div><p class=\"atext\">\ud65c\ub3d9\uc801\uc73c\ub85c \uc6c0\uc9c1\uc774\uae30 \uc88b\uc740 \ud55c \uc8fc\uc785\ub2c8\ub2e4.</p></div>\n      <div class=\"acard\"><div class=\"asym\">\ud83d\udc10</div><div class=\"aname\">\uc591\ub760</div><p class=\"atext\">\ub9c8\uc74c\uc758 \uc5ec\uc720\uac00 \ud544\uc694\ud55c \uc2dc\uae30, \ubb34\ub9ac\ud558\uc9c0 \ub9c8\uc138\uc694.</p></div>\n      <div class=\"acard\"><div class=\"asym\">\ud83d\udc35</div><div class=\"aname\">\uc6d0\uc22d\uc774\ub760</div><p class=\"atext\">\uc7ac\uce58\uc640 \uc21c\ubc1c\ub825\uc774 \ube5b\ub098\ub294 \uc8fc\uc608\uc694.</p></div>\n      <div class=\"acard\"><div class=\"asym\">\ud83d\udc13</div><div class=\"aname\">\ub2ed\ub760</div><p class=\"atext\">\uc815\ub9ac\uc640 \uacc4\ud68d\uc5d0 \uc88b\uc740 \ud750\ub984\uc774\uc5d0\uc694.</p></div>\n      <div class=\"acard\"><div class=\"asym\">\ud83d\udc36</div><div class=\"aname\">\uac1c\ub760</div><p class=\"atext\">\uc2e0\ub8b0\uac00 \uc313\uc774\ub294 \uc2dc\uae30, \uacc1\uc5d0 \uc788\ub294 \uc0ac\ub78c\uc744 \ucc59\uae30\uc138\uc694.</p></div>\n      <div class=\"acard\"><div class=\"asym\">\ud83d\udc37</div><div class=\"aname\">\ub3fc\uc9c0\ub760</div><p class=\"atext\">\uc7ac\ubb3c\uc6b4\uc774 \uc11c\uc11c\ud788 \uc88b\uc544\uc9c0\ub294 \ud750\ub984\uc774\uc5d0\uc694.</p></div>\n    </div>\n\n    <div class=\"upsell\">\n      <p>\ub760 \ub9d0\uace0, \ub0b4 \uc0ac\uc8fc \ub124 \uae30\ub465\uc774 \uad81\uae08\ud558\ub2e4\uba74?</p>\n      <a href=\"/saju/\">\ub098\uc758 \uc0ac\uc8fc\ud480\uc774 \ubcf4\ub7ec\uac00\uae30 &rarr;</a>\n    </div>\n\n  </div>\n</div>\n\n<!-- /wp:html -->\n"