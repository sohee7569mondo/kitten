"<!-- wp:html -->\n<!--\n  STELLA SAJU \u2014 \uc6b4\uba85\uc758 \ucc45 (\ud398\uc774\uc9c0 ID 85)   BUILD: O2\n\n  \uc0c1\ub2e8 \uba54\ub274/\ud478\ud130\ub294 \ud14c\ub9c8 \ud15c\ud50c\ub9bf \ud30c\ud2b8\uc5d0 \uc788\uc2b5\ub2c8\ub2e4. \uc5ec\uae30\uc5d4 \ubcf8\ubb38\ub9cc \uc788\uc2b5\ub2c8\ub2e4.\n  [\uace0\uce5c \uac83] \uc544\ubc14\ud0c0 \uc774\ubbf8\uc9c0\uac00 \ub2e4\ub978 \uc0ac\uc774\ud2b8(cancan8.wordpress.com)\ub97c \uac00\ub9ac\ud0a4\uace0 \uc788\uc5b4\n           stellasaju.com \uc758 \ubbf8\ub514\uc5b4(ID 55)\ub85c \ubc14\ub85c\uc7a1\uc558\uc2b5\ub2c8\ub2e4.\n  [\ubb38\uad6c \ucd94\uac00/\uc218\uc815] \uc544\ub798 LINES \ubc30\uc5f4\uc5d0 \ud55c \uc904\uc529 \ub123\uace0 \ube7c\uba74 \ub429\ub2c8\ub2e4.\n-->\n<style>\n#ssp{\n  --void:#0D0A1A; --void-deep:#070512;\n  --nebula:#1C1533; --nebula-soft:#251C42;\n  --purple-glow:rgba(140,101,214,.35);\n  --gold:#D4AF6A; --gold-soft:#C9A66B; --gold-lite:#E8CD96;\n  --star:#F2ECE0; --ink-soft:rgba(242,236,224,.72); --ink-dim:rgba(242,236,224,.46);\n  --line:rgba(212,175,106,.18);\n\n  max-width:none !important; width:auto !important;\n  margin-left:calc(50% - 50vw) !important; margin-right:calc(50% - 50vw) !important;\n  padding:0 !important;\n  position:relative; z-index:0; overflow-x:clip;\n  color:var(--star); text-align:center;\n  font-family:'Noto Sans KR',-apple-system,'Apple SD Gothic Neo','Malgun Gothic',sans-serif;\n  font-weight:300; line-height:1.75; font-size:16px;\n  word-break:keep-all; overflow-wrap:break-word;\n}\n#ssp *{margin:0; padding:0; box-sizing:border-box;}\n#ssp h1,#ssp h2,#ssp h3{font-family:'Noto Serif KR',serif; color:var(--star); font-weight:700; letter-spacing:normal;}\n#ssp a{color:inherit; text-decoration:none;}\n#ssp button{font:inherit;}\n\n#ssp .ssp-stars{\n  position:fixed; inset:0; z-index:0; pointer-events:none;\n  background:\n    radial-gradient(1.5px 1.5px at 12% 18%, rgba(255,255,255,.9), transparent),\n    radial-gradient(1px 1px at 82% 12%, rgba(255,255,255,.7), transparent),\n    radial-gradient(1.5px 1.5px at 62% 62%, rgba(255,255,255,.8), transparent),\n    radial-gradient(1px 1px at 28% 78%, rgba(255,255,255,.6), transparent),\n    radial-gradient(1.5px 1.5px at 90% 52%, rgba(255,255,255,.7), transparent),\n    radial-gradient(1px 1px at 45% 32%, rgba(255,255,255,.5), transparent),\n    var(--void);\n}\n#ssp .ssp-inner{position:relative; z-index:1; max-width:1080px; margin:0 auto; padding:76px 24px 110px;}\n@media(max-width:700px){ #ssp .ssp-inner{padding:48px 18px 80px;} }\n\n#ssp .ssp-kicker{font-family:'IBM Plex Mono',monospace; font-size:.7rem; letter-spacing:.22em;\n  text-transform:uppercase; color:var(--gold); margin-bottom:16px;}\n#ssp h1{font-size:clamp(1.8rem,4.6vw,2.8rem); line-height:1.35;}\n#ssp .ssp-lead{margin:18px auto 0; color:var(--ink-soft); font-size:1rem; max-width:560px;}\n\n#ssp .upsell{margin:52px auto 0; max-width:560px; padding:28px 24px;\n  border:1px solid var(--line); border-radius:10px;}\n#ssp .upsell p{font-size:.92rem; color:var(--ink-soft);}\n#ssp .upsell a{display:inline-block; margin-top:14px; font-family:'IBM Plex Mono',monospace;\n  font-size:.82rem; color:var(--gold); border-bottom:1px solid var(--gold-soft); padding-bottom:3px;}\n#ssp .upsell a:hover{color:var(--gold-lite);}\n@media(prefers-reduced-motion:reduce){\n  #ssp *,#ssp *::before,#ssp *::after{animation:none !important; transition:none !important;}\n}\n\n#ssp .stage{\n  margin:52px auto 0; max-width:640px; padding:52px 36px 42px; border-radius:14px;\n  background:radial-gradient(ellipse at 50% 0%, rgba(140,101,214,.14), transparent 62%), var(--nebula);\n  border:1px solid var(--line); box-shadow:0 40px 90px -50px rgba(0,0,0,.9);\n}\n@media(max-width:700px){ #ssp .stage{padding:34px 20px 32px; margin-top:36px; border-radius:12px;} }\n\n/* \ucc45 */\n#ssp .book-stage{perspective:1400px; display:flex !important; justify-content:center;}\n#ssp .book{position:relative; width:260px; height:188px;}\n@media(max-width:520px){ #ssp .book{width:210px; height:152px;} }\n#ssp .book-cover{position:absolute; inset:0; border-radius:4px 10px 10px 4px;\n  background:linear-gradient(135deg, #2A1F4A, #150F2C);\n  border:1px solid var(--gold-soft);\n  box-shadow:0 26px 54px -18px var(--purple-glow), inset 0 0 0 7px rgba(212,175,106,.08);\n  display:flex; align-items:center; justify-content:center;}\n#ssp .book-cover .glyph{font-family:'Noto Serif KR',serif; font-size:2rem; color:var(--gold-soft); opacity:.75;}\n#ssp .book-spine{position:absolute; left:-5px; top:5px; bottom:5px; width:9px;\n  background:var(--gold-soft); opacity:.45; border-radius:3px;}\n#ssp .book-page{position:absolute; inset:8px 8px 8px 13px; border-radius:2px 8px 8px 2px;\n  background:linear-gradient(135deg,#F4EFE4,#E2D8C1); transform-origin:left center;\n  display:flex; align-items:center; justify-content:center; padding:18px;\n  box-shadow:inset 0 0 22px rgba(120,100,60,.2);}\n#ssp .book-page.flip{animation:ssp-flip 1.1s ease forwards;}\n@keyframes ssp-flip{0%{transform:rotateY(0);}50%{transform:rotateY(-105deg);}100%{transform:rotateY(0);}}\n#ssp .book-page-text{font-family:'Noto Serif KR',serif; font-size:.82rem; color:#241B12;\n  text-align:center; line-height:1.7;}\n\n#ssp .seer{width:64px; height:64px; margin:26px auto 0; border-radius:50%; overflow:hidden;\n  border:1px solid var(--gold-soft); box-shadow:0 0 26px var(--purple-glow);}\n#ssp .seer img{width:100%; height:100%; object-fit:cover; object-position:center 15%; display:block;}\n\n#ssp .qinput{width:100%; margin-top:26px; background:var(--void-deep); border:1px solid var(--line);\n  color:var(--star); padding:15px 18px; border-radius:5px; font-family:inherit; font-size:.95rem;\n  text-align:center; transition:border-color .2s ease;}\n#ssp .qinput:focus{outline:none; border-color:var(--gold-soft);}\n#ssp .qinput::placeholder{color:var(--ink-dim);}\n\n#ssp .btn{margin-top:20px; padding:16px 36px; border-radius:3px; border:none; cursor:pointer;\n  font-size:.95rem; font-weight:700; color:var(--void-deep);\n  background:linear-gradient(135deg, var(--gold), #B98A47);\n  box-shadow:0 16px 34px -14px rgba(212,175,106,.55); transition:transform .2s ease, opacity .2s ease;}\n#ssp .btn:hover{transform:translateY(-2px);}\n#ssp .btn:disabled{opacity:.45; cursor:default; transform:none;}\n\n#ssp .answer{margin-top:30px; min-height:30px; font-family:'Noto Serif KR',serif;\n  font-size:1.12rem; color:var(--gold); line-height:1.8;\n  opacity:0; transform:translateY(8px); transition:opacity .5s ease, transform .5s ease;}\n#ssp .answer.show{opacity:1; transform:none;}\n#ssp .answer .q{display:block; font-size:.82rem; color:var(--ink-dim);\n  font-family:'Noto Sans KR',sans-serif; margin-bottom:10px;}\n#ssp .note{margin-top:24px; font-family:'IBM Plex Mono',monospace; font-size:.72rem; color:var(--ink-dim);}\n\n</style>\n\n<div id=\"ssp\">\n  <div class=\"ssp-stars\" aria-hidden=\"true\"></div>\n  <div class=\"ssp-inner\">\n\n    <div class=\"ssp-kicker\">Free &middot; \ubb34\uc81c\ud55c</div>\n    <h1>\uc6b4\uba85\uc758 \ucc45</h1>\n    <p class=\"ssp-lead\">\uc9c8\ubb38 \ud558\ub098\ub97c \ub5a0\uc62c\ub9ac\uace0 \ucc45\uc7a5\uc744 \ub118\uae30\uba74, \uba85\uc131\uc758 \uc2e0\uc774 \uc9e7\uc740 \ud55c \uc904\uc744 \uc804\ud574\ub4dc\ub824\uc694.<br>\uba87 \ubc88\uc774\ub4e0 \uc5f4\uc5b4\ubcf4\uc138\uc694.</p>\n\n    <div class=\"stage\">\n      <div class=\"book-stage\">\n        <div class=\"book\">\n          <div class=\"book-spine\" aria-hidden=\"true\"></div>\n          <div class=\"book-cover\" aria-hidden=\"true\"><div class=\"glyph\">&#20874;</div></div>\n          <div class=\"book-page\" id=\"bookPage\"><div class=\"book-page-text\" id=\"bookPageText\"></div></div>\n        </div>\n      </div>\n\n      <div class=\"seer\">\n        <img src=\"https://stellasaju.com/wp-content/uploads/2026/08/grok_1787062580711.jpg\"\n             alt=\"\uba85\uc131\uc758 \uc2e0\" width=\"784\" height=\"1168\" loading=\"lazy\">\n      </div>\n\n      <input type=\"text\" id=\"oracleQ\" class=\"qinput\" maxlength=\"60\"\n             placeholder=\"\uc608: \uc624\ub298 \uc911\uc694\ud55c \uacb0\uc815\uc744 \ub0b4\ub824\ub3c4 \ub420\uae4c\uc694?\">\n      <button type=\"button\" class=\"btn\" id=\"oracleBtn\">\ucc45\uc7a5 \ub118\uae30\uae30 &rarr;</button>\n\n      <div class=\"answer\" id=\"oracleAnswer\" aria-live=\"polite\"></div>\n      <div class=\"note\">\ud558\ub8e8 \uba87 \ubc88\uc774\ub4e0 \uc5f4\uc5b4\ubcfc \uc218 \uc788\uc5b4\uc694</div>\n    </div>\n\n    <div class=\"upsell\">\n      <p>\ud55c \uc904 \ub9d0\uace0, \uc81c\ub300\ub85c \ub41c \ud480\uc774\uac00 \uad81\uae08\ud558\ub2e4\uba74?</p>\n      <a href=\"/#doors\">\uc5ec\uc12f \uac1c\uc758 \ubb38 \uc5f4\uc5b4\ubcf4\uae30 &rarr;</a>\n    </div>\n\n  </div>\n</div>\n\n<script>\n(function(){\n  var LINES = [\n    '\uc624\ub298\uc740 \ubb34\ub9ac\ud55c \uc9c0\ucd9c\uc744 \uc0bc\uac00\uc138\uc694.',\n    '\uc9c0\uae08\uc740 \uae30\ub2e4\ub9bc\uc774 \ub2f5\uc77c \uc218 \uc788\uc5b4\uc694.',\n    '\uc791\uc740 \uacb0\uc815\uc774 \ud070 \ud750\ub984\uc744 \ubc14\uafc9\ub2c8\ub2e4.',\n    '\uac00\uae4c\uc6b4 \uc0ac\ub78c\uc758 \ub9d0\uc5d0 \uadc0 \uae30\uc6b8\uc5ec\ubcf4\uc138\uc694.',\n    '\uc11c\ub450\ub974\uc9c0 \uc54a\uc544\ub3c4 \ub2a6\uc9c0 \uc54a\uc544\uc694.',\n    '\uc624\ub298 \ud558\ub8e8\ub294 \uc2a4\uc2a4\ub85c\ub97c \uba3c\uc800 \ub3cc\ubcf4\uc138\uc694.',\n    '\uc9c0\uae08\uc758 \uc120\ud0dd, \ub098\uc058\uc9c0 \uc54a\uc740 \ubc29\ud5a5\uc774\uc5d0\uc694.',\n    '\uc7a0\uc2dc \uba48\ucd94\ub294 \uac83\ub3c4 \ub098\uc544\uac00\ub294 \ubc29\ubc95\uc774\uc5d0\uc694.',\n    '\ub9c8\uc74c\uc774 \uac00\ub294 \ucabd\uc774 \ub2f5\uc77c \ub54c\uac00 \ub9ce\uc544\uc694.',\n    '\uc624\ub298\uc740 \ud3c9\uc18c\ubcf4\ub2e4 \uc870\uae08 \ub354 \uc2e0\uc911\ud558\uac8c.'\n  ];\n  var btn=document.getElementById('oracleBtn'), ans=document.getElementById('oracleAnswer');\n  var page=document.getElementById('bookPage'), pageText=document.getElementById('bookPageText');\n  var qbox=document.getElementById('oracleQ');\n  if(!btn) return;\n  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n  var last = -1, busy = false;\n\n  function pick(){                      // \uac19\uc740 \uc904\uc774 \uc5f0\ub2ec\uc544 \ub098\uc624\uc9c0 \uc54a\uac8c\n    var i; do { i = Math.floor(Math.random()*LINES.length); } while(LINES.length>1 && i===last);\n    last = i; return LINES[i];\n  }\n  function esc(s){ return s.replace(/[&<>\"]/g, function(c){\n    return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]; }); }\n\n  function reveal(q, line){\n    ans.innerHTML = (q ? '<span class=\"q\">\\u201C' + esc(q) + '\\u201D</span>' : '') + esc(line);\n    ans.classList.add('show');\n  }\n\n  btn.addEventListener('click', function(){\n    if(busy) return;\n    var q = qbox.value.trim();\n    var line = pick();\n\n    if(reduce){ pageText.textContent = line; reveal(q, line); return; }\n\n    busy = true; btn.disabled = true;\n    ans.classList.remove('show');\n    page.classList.remove('flip');\n    void page.offsetWidth;              // \uc560\ub2c8\uba54\uc774\uc158 \uc7ac\uc2dc\uc791\n    page.classList.add('flip');\n    pageText.textContent = '';\n    setTimeout(function(){ pageText.textContent = line; }, 560);\n    setTimeout(function(){\n      reveal(q, line);\n      busy = false; btn.disabled = false;\n      btn.textContent = '\ub2e4\uc2dc \ub118\uae30\uae30 \\u2192';\n    }, 680);\n  });\n  qbox.addEventListener('keydown', function(e){ if(e.key==='Enter') btn.click(); });\n})();\n</script>\n<!-- /wp:html -->\n"