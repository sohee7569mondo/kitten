"<!-- wp:html -->\n<!--\n  STELLA SAJU \u2014 \uc774\ubc88\uc8fc \ubcc4\uc790\ub9ac \uc6b4\uc138 (\ud398\uc774\uc9c0 ID 82)   BUILD: Z2\n\n  \uc0c1\ub2e8 \uba54\ub274/\ud478\ud130\ub294 \ud14c\ub9c8 \ud15c\ud50c\ub9bf \ud30c\ud2b8\uc5d0 \uc788\uc2b5\ub2c8\ub2e4. \uc5ec\uae30\uc5d4 \ubcf8\ubb38\ub9cc \uc788\uc2b5\ub2c8\ub2e4.\n  \ubaa8\ub4e0 CSS \ub294 #ssp \uc548\uc73c\ub85c \ubb36\uc5ec \uc788\uc5b4 \ub2e4\ub978 \ud398\uc774\uc9c0\uc5d0 \uc601\ud5a5\uc744 \uc8fc\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\n-->\n<style>\n#ssp{\n  --void:#0D0A1A; --void-deep:#070512;\n  --nebula:#1C1533; --nebula-soft:#251C42;\n  --purple-glow:rgba(140,101,214,.35);\n  --gold:#D4AF6A; --gold-soft:#C9A66B; --gold-lite:#E8CD96;\n  --star:#F2ECE0; --ink-soft:rgba(242,236,224,.72); --ink-dim:rgba(242,236,224,.46);\n  --line:rgba(212,175,106,.18);\n\n  max-width:none !important; width:auto !important;\n  margin-left:calc(50% - 50vw) !important; margin-right:calc(50% - 50vw) !important;\n  padding:0 !important;\n  position:relative; z-index:0; overflow-x:clip;\n  color:var(--star); text-align:center;\n  font-family:'Noto Sans KR',-apple-system,'Apple SD Gothic Neo','Malgun Gothic',sans-serif;\n  font-weight:300; line-height:1.75; font-size:16px;\n  word-break:keep-all; overflow-wrap:break-word;\n}\n#ssp *{margin:0; padding:0; box-sizing:border-box;}\n#ssp h1,#ssp h2,#ssp h3{font-family:'Noto Serif KR',serif; color:var(--star); font-weight:700; letter-spacing:normal;}\n#ssp a{color:inherit; text-decoration:none;}\n#ssp button{font:inherit;}\n\n#ssp .ssp-stars{\n  position:fixed; inset:0; z-index:0; pointer-events:none;\n  background:\n    radial-gradient(1.5px 1.5px at 12% 18%, rgba(255,255,255,.9), transparent),\n    radial-gradient(1px 1px at 82% 12%, rgba(255,255,255,.7), transparent),\n    radial-gradient(1.5px 1.5px at 62% 62%, rgba(255,255,255,.8), transparent),\n    radial-gradient(1px 1px at 28% 78%, rgba(255,255,255,.6), transparent),\n    radial-gradient(1.5px 1.5px at 90% 52%, rgba(255,255,255,.7), transparent),\n    radial-gradient(1px 1px at 45% 32%, rgba(255,255,255,.5), transparent),\n    var(--void);\n}\n#ssp .ssp-inner{position:relative; z-index:1; max-width:1080px; margin:0 auto; padding:76px 24px 110px;}\n@media(max-width:700px){ #ssp .ssp-inner{padding:48px 18px 80px;} }\n\n#ssp .ssp-kicker{font-family:'IBM Plex Mono',monospace; font-size:.7rem; letter-spacing:.22em;\n  text-transform:uppercase; color:var(--gold); margin-bottom:16px;}\n#ssp h1{font-size:clamp(1.8rem,4.6vw,2.8rem); line-height:1.35;}\n#ssp .ssp-lead{margin:18px auto 0; color:var(--ink-soft); font-size:1rem; max-width:560px;}\n\n#ssp .upsell{margin:52px auto 0; max-width:560px; padding:28px 24px;\n  border:1px solid var(--line); border-radius:10px;}\n#ssp .upsell p{font-size:.92rem; color:var(--ink-soft);}\n#ssp .upsell a{display:inline-block; margin-top:14px; font-family:'IBM Plex Mono',monospace;\n  font-size:.82rem; color:var(--gold); border-bottom:1px solid var(--gold-soft); padding-bottom:3px;}\n#ssp .upsell a:hover{color:var(--gold-lite);}\n@media(prefers-reduced-motion:reduce){\n  #ssp *,#ssp *::before,#ssp *::after{animation:none !important; transition:none !important;}\n}\n\n#ssp .zgrid{display:grid !important; grid-template-columns:repeat(3,1fr); gap:16px; margin-top:52px; text-align:left;}\n@media(max-width:900px){ #ssp .zgrid{grid-template-columns:repeat(2,1fr);} }\n@media(max-width:600px){ #ssp .zgrid{grid-template-columns:1fr;} }\n#ssp .zcard{background:var(--nebula); border:1px solid var(--line); border-radius:12px; padding:26px 24px;\n  position:relative; overflow:hidden; transition:border-color .25s ease, transform .25s ease;}\n#ssp .zcard::before{content:''; position:absolute; top:0; left:0; right:0; height:2px;\n  background:linear-gradient(to right, var(--zc), transparent);}\n#ssp .zcard:hover{border-color:var(--gold-soft); transform:translateY(-3px);}\n#ssp .zhead{display:flex !important; align-items:center; gap:14px;}\n#ssp .zsym{width:52px; height:52px; flex:0 0 auto; border-radius:50%;\n  display:flex; align-items:center; justify-content:center; font-size:1.7rem; color:var(--zc);\n  background:var(--void-deep); border:1px solid var(--zc);}\n#ssp .zname{font-family:'Noto Serif KR',serif; font-weight:700; font-size:1.1rem;}\n#ssp .zdate{margin-top:3px; font-family:'IBM Plex Mono',monospace; font-size:.62rem; color:var(--ink-dim);}\n#ssp .ztext{margin-top:16px; font-size:.87rem; color:var(--ink-soft); line-height:1.85;}\n#ssp .zlucky{margin-top:18px; padding-top:15px; border-top:1px solid var(--line); display:flex !important; gap:20px;}\n#ssp .zlucky-item{flex:1;}\n#ssp .zlucky-label{font-family:'IBM Plex Mono',monospace; font-size:.58rem; color:var(--ink-dim);\n  letter-spacing:.08em; text-transform:uppercase;}\n#ssp .zlucky-value{margin-top:5px; font-size:.88rem; color:var(--star);\n  display:flex !important; align-items:center; gap:7px; font-family:'IBM Plex Mono',monospace;}\n#ssp .zdot{width:13px; height:13px; border-radius:50%; flex:0 0 auto; border:1px solid rgba(255,255,255,.25);}\n\n</style>\n\n<div id=\"ssp\">\n  <div class=\"ssp-stars\" aria-hidden=\"true\"></div>\n  <div class=\"ssp-inner\">\n\n    <div class=\"ssp-kicker\">Free &middot; \uc774\ubc88\uc8fc</div>\n    <h1>\uc774\ubc88\uc8fc \ubcc4\uc790\ub9ac \uc6b4\uc138</h1>\n    <p class=\"ssp-lead\">\uc131\uc88c\uc758 \uc2e0\uc774 \uc5f4\ub450 \ubcc4\uc790\ub9ac\uc758 \uc774\ubc88\uc8fc \ud750\ub984\uc744 \uc9e7\uac8c \uc9da\uc5b4\ub4dc\ub824\uc694.</p>\n\n    <div class=\"zgrid\">\n      <div class=\"zcard\" style=\"--zc:#E85D5D\">\n        <div class=\"zhead\"><div class=\"zsym\">\u2648</div>\n          <div><div class=\"zname\">\uc591\uc790\ub9ac</div><div class=\"zdate\">3.21-4.19</div></div></div>\n        <p class=\"ztext\">\ucd94\uc9c4\ub825\uc774 \uc0b4\uc544\ub098\ub294 \ud55c \uc8fc\uc608\uc694. \ubbf8\ub904\ub454 \uc77c\uc744 \uba3c\uc800 \uc2dc\uc791\ud574\ubcf4\uc138\uc694. \ub2e4\ub9cc \uc131\uae09\ud558\uac8c \ubc00\uc5b4\ubd99\uc774\uba74 \uc8fc\ubcc0\uacfc \ubd80\ub52a\ud790 \uc218 \uc788\uc73c\ub2c8, \uc18d\ub3c4\ubcf4\ub2e4 \ubc29\ud5a5\uc744 \ud55c \ubc88 \ub354 \uc810\uac80\ud558\ub294 \uac8c \uc88b\uc544\uc694.</p>\n        <div class=\"zlucky\">\n          <div class=\"zlucky-item\"><div class=\"zlucky-label\">\ud589\uc6b4\uc758 \uc22b\uc790</div><div class=\"zlucky-value\">7</div></div>\n          <div class=\"zlucky-item\"><div class=\"zlucky-label\">\ud589\uc6b4\uc758 \uceec\ub7ec</div><div class=\"zlucky-value\"><span class=\"zdot\" style=\"background:#E85D5D\"></span>\ub808\ub4dc</div></div>\n        </div>\n      </div>\n      <div class=\"zcard\" style=\"--zc:#7CB579\">\n        <div class=\"zhead\"><div class=\"zsym\">\u2649</div>\n          <div><div class=\"zname\">\ud669\uc18c\uc790\ub9ac</div><div class=\"zdate\">4.20-5.20</div></div></div>\n        <p class=\"ztext\">\uc11c\ub450\ub974\uc9c0 \uc54a\uc544\ub3c4 \uad1c\ucc2e\uc740 \uc2dc\uae30\uc608\uc694. \uafb8\uc900\ud568\uc774 \uc774\ubc88\uc8fc \ubb34\uae30\uac00 \ub3fc\uc694. \uc7ac\uc815 \ucabd\uc73c\ub85c \uc791\uc740 \uacb0\uc815\uc744 \ub0b4\ub9ac\uae30 \uc88b\uc740 \ud0c0\uc774\ubc0d\uc774\ub2c8, \ubbf8\ub904\ub454 \uc9c0\ucd9c \uacc4\ud68d\uc744 \uc815\ub9ac\ud574\ubcf4\uc138\uc694.</p>\n        <div class=\"zlucky\">\n          <div class=\"zlucky-item\"><div class=\"zlucky-label\">\ud589\uc6b4\uc758 \uc22b\uc790</div><div class=\"zlucky-value\">14</div></div>\n          <div class=\"zlucky-item\"><div class=\"zlucky-label\">\ud589\uc6b4\uc758 \uceec\ub7ec</div><div class=\"zlucky-value\"><span class=\"zdot\" style=\"background:#7CB579\"></span>\uadf8\ub9b0</div></div>\n        </div>\n      </div>\n      <div class=\"zcard\" style=\"--zc:#E8C85D\">\n        <div class=\"zhead\"><div class=\"zsym\">\u264a</div>\n          <div><div class=\"zname\">\uc30d\ub465\uc774\uc790\ub9ac</div><div class=\"zdate\">5.21-6.21</div></div></div>\n        <p class=\"ztext\">\ub300\ud654\uc5d0\uc11c \uc88b\uc740 \uae30\ud68c\uac00 \uc5f4\ub824\uc694. \uba3c\uc800 \ub9d0\uc744 \uac78\uc5b4\ubcf4\uc138\uc694. \uc0c8\ub85c\uc6b4 \uc815\ubcf4\uac00 \ub4e4\uc5b4\uc624\ub294 \uc8fc\ub77c, \ud3c9\uc18c \uad00\uc2ec \uc788\ub358 \ubd84\uc57c \uc18c\uc2dd\uc744 \ucc59\uaca8\ubcf4\uba74 \ub73b\ubc16\uc758 \ud78c\ud2b8\ub97c \uc5bb\uc744 \uc218 \uc788\uc5b4\uc694.</p>\n        <div class=\"zlucky\">\n          <div class=\"zlucky-item\"><div class=\"zlucky-label\">\ud589\uc6b4\uc758 \uc22b\uc790</div><div class=\"zlucky-value\">5</div></div>\n          <div class=\"zlucky-item\"><div class=\"zlucky-label\">\ud589\uc6b4\uc758 \uceec\ub7ec</div><div class=\"zlucky-value\"><span class=\"zdot\" style=\"background:#E8C85D\"></span>\uc610\ub85c\uc6b0</div></div>\n        </div>\n      </div>\n      <div class=\"zcard\" style=\"--zc:#B0C4E8\">\n        <div class=\"zhead\"><div class=\"zsym\">\u264b</div>\n          <div><div class=\"zname\">\uac8c\uc790\ub9ac</div><div class=\"zdate\">6.22-7.22</div></div></div>\n        <p class=\"ztext\">\uc9d1\uacfc \uac00\uc871 \ucabd\uc5d0 \ub9c8\uc74c\uc774 \uc4f0\uc774\ub294 \ud55c \uc8fc\uc608\uc694. \ubb34\ub9ac\ud55c \uc57d\uc18d\uc740 \ud53c\ud558\uace0, \uc775\uc219\ud55c \uacf5\uac04\uc5d0\uc11c \uc7ac\ucda9\uc804\ud558\ub294 \uc2dc\uac04\uc744 \uac00\uc9c0\uba74 \ucee8\ub514\uc158\uc774 \ube60\ub974\uac8c \ud68c\ubcf5\ub3fc\uc694.</p>\n        <div class=\"zlucky\">\n          <div class=\"zlucky-item\"><div class=\"zlucky-label\">\ud589\uc6b4\uc758 \uc22b\uc790</div><div class=\"zlucky-value\">2</div></div>\n          <div class=\"zlucky-item\"><div class=\"zlucky-label\">\ud589\uc6b4\uc758 \uceec\ub7ec</div><div class=\"zlucky-value\"><span class=\"zdot\" style=\"background:#B0C4E8\"></span>\uc2e4\ubc84\ube14\ub8e8</div></div>\n        </div>\n      </div>\n      <div class=\"zcard\" style=\"--zc:#E8A85D\">\n        <div class=\"zhead\"><div class=\"zsym\">\u264c</div>\n          <div><div class=\"zname\">\uc0ac\uc790\uc790\ub9ac</div><div class=\"zdate\">7.23-8.22</div></div></div>\n        <p class=\"ztext\">\uc774\ubc88\uc8fc \ud750\ub984\uc774 \uac00\uc7a5 \uc88b\uc740 \ubcc4\uc790\ub9ac\uc608\uc694. \ub098\uc11c\ub3c4 \uc88b\uc740 \ud0c0\uc774\ubc0d\uc774\ub2c8 \ubbf8\ub904\ub480\ub358 \uc81c\uc548\uc774\ub098 \ub3c4\uc804\uc744 \uc774\ubc88\uc8fc\uc5d0 \uaebc\ub0b4\ubcf4\uc138\uc694. \uc8fc\ubcc0\uc758 \uc9c0\uc9c0\ub97c \ubc1b\uae30 \uc26c\uc6b4 \uc2dc\uae30\uc608\uc694.</p>\n        <div class=\"zlucky\">\n          <div class=\"zlucky-item\"><div class=\"zlucky-label\">\ud589\uc6b4\uc758 \uc22b\uc790</div><div class=\"zlucky-value\">19</div></div>\n          <div class=\"zlucky-item\"><div class=\"zlucky-label\">\ud589\uc6b4\uc758 \uceec\ub7ec</div><div class=\"zlucky-value\"><span class=\"zdot\" style=\"background:#E8A85D\"></span>\uace8\ub4dc</div></div>\n        </div>\n      </div>\n      <div class=\"zcard\" style=\"--zc:#8FBFAE\">\n        <div class=\"zhead\"><div class=\"zsym\">\u264d</div>\n          <div><div class=\"zname\">\ucc98\ub140\uc790\ub9ac</div><div class=\"zdate\">8.23-9.22</div></div></div>\n        <p class=\"ztext\">\ub514\ud14c\uc77c\uc744 \ucc59\uae30\ub294 \uac8c \ube5b\uc744 \ubc1c\ud558\ub294 \uc8fc\uc608\uc694. \uc815\ub9ac\uc815\ub3c8\ubd80\ud130 \uc2dc\uc791\ud574\ubcf4\uc138\uc694. \uc5c5\ubb34\ub098 \uc11c\ub958 \ucabd\uc5d0\uc11c \uaf3c\uaf3c\ud568\uc774 \uc88b\uc740 \ud3c9\uac00\ub85c \uc774\uc5b4\uc9c8 \uc218 \uc788\uc5b4\uc694.</p>\n        <div class=\"zlucky\">\n          <div class=\"zlucky-item\"><div class=\"zlucky-label\">\ud589\uc6b4\uc758 \uc22b\uc790</div><div class=\"zlucky-value\">11</div></div>\n          <div class=\"zlucky-item\"><div class=\"zlucky-label\">\ud589\uc6b4\uc758 \uceec\ub7ec</div><div class=\"zlucky-value\"><span class=\"zdot\" style=\"background:#8FBFAE\"></span>\uc138\uc774\uc9c0\uadf8\ub9b0</div></div>\n        </div>\n      </div>\n      <div class=\"zcard\" style=\"--zc:#D9B8E8\">\n        <div class=\"zhead\"><div class=\"zsym\">\u264e</div>\n          <div><div class=\"zname\">\ucc9c\uce6d\uc790\ub9ac</div><div class=\"zdate\">9.23-10.22</div></div></div>\n        <p class=\"ztext\">\uade0\ud615\uc744 \ucc3e\ub294 \ud55c \uc8fc\uc608\uc694. \uc911\uc694\ud55c \uacb0\uc815\uc740 \uc870\uae08 \ubbf8\ub904\ub3c4 \uad1c\ucc2e\uc544\uc694. \uc0ac\ub78c \uc0ac\uc774\uc758 \uac08\ub4f1\uc774 \uc788\uc5c8\ub2e4\uba74 \uc774\ubc88\uc8fc\uc5d0 \uc790\uc5f0\uc2a4\ub7fd\uac8c \ud480\ub9b4 \uae30\ud68c\uac00 \uc640\uc694.</p>\n        <div class=\"zlucky\">\n          <div class=\"zlucky-item\"><div class=\"zlucky-label\">\ud589\uc6b4\uc758 \uc22b\uc790</div><div class=\"zlucky-value\">6</div></div>\n          <div class=\"zlucky-item\"><div class=\"zlucky-label\">\ud589\uc6b4\uc758 \uceec\ub7ec</div><div class=\"zlucky-value\"><span class=\"zdot\" style=\"background:#D9B8E8\"></span>\ub77c\ubca4\ub354</div></div>\n        </div>\n      </div>\n      <div class=\"zcard\" style=\"--zc:#8B3A5E\">\n        <div class=\"zhead\"><div class=\"zsym\">\u264f</div>\n          <div><div class=\"zname\">\uc804\uac08\uc790\ub9ac</div><div class=\"zdate\">10.23-11.21</div></div></div>\n        <p class=\"ztext\">\uc9c1\uac10\uc774 \uc720\ub3c5 \ub0a0\uce74\ub85c\uc6b4 \uc2dc\uae30\uc608\uc694. \ucd09\uc774 \uc624\ub294 \ub300\ub85c \uc6c0\uc9c1\uc5ec\ub3c4 \uc88b\uc544\uc694. \ub2e4\ub9cc \uac10\uc815\uc774 \uaca9\ud574\uc9c0\uae30 \uc26c\uc6b0\ub2c8 \uc911\uc694\ud55c \ub9d0\uc740 \ud558\ub8e8 \ubb35\ud600\uc11c \ud558\ub294 \uac8c \uc548\uc804\ud574\uc694.</p>\n        <div class=\"zlucky\">\n          <div class=\"zlucky-item\"><div class=\"zlucky-label\">\ud589\uc6b4\uc758 \uc22b\uc790</div><div class=\"zlucky-value\">9</div></div>\n          <div class=\"zlucky-item\"><div class=\"zlucky-label\">\ud589\uc6b4\uc758 \uceec\ub7ec</div><div class=\"zlucky-value\"><span class=\"zdot\" style=\"background:#8B3A5E\"></span>\ubc84\uac74\ub514</div></div>\n        </div>\n      </div>\n      <div class=\"zcard\" style=\"--zc:#5D8FE8\">\n        <div class=\"zhead\"><div class=\"zsym\">\u2650</div>\n          <div><div class=\"zname\">\uc0ac\uc218\uc790\ub9ac</div><div class=\"zdate\">11.22-12.21</div></div></div>\n        <p class=\"ztext\">\uba40\ub9ac \ubcf4\ub294 \uacc4\ud68d\uc744 \uc138\uc6b0\uae30 \uc88b\uc740 \ub54c\uc608\uc694. \uc5ec\ud589\uc774\ub098 \ubc30\uc6c0\ucc98\ub7fc \uc2dc\uc57c\ub97c \ub113\ud788\ub294 \uc77c\uc5d0 \ub9c8\uc74c\uc774 \ub04c\ub9b0\ub2e4\uba74 \uc774\ubc88\uc8fc\uc5d0 \uc54c\uc544\ubcf4\ub294 \uac78 \ucd94\ucc9c\ud574\uc694.</p>\n        <div class=\"zlucky\">\n          <div class=\"zlucky-item\"><div class=\"zlucky-label\">\ud589\uc6b4\uc758 \uc22b\uc790</div><div class=\"zlucky-value\">23</div></div>\n          <div class=\"zlucky-item\"><div class=\"zlucky-label\">\ud589\uc6b4\uc758 \uceec\ub7ec</div><div class=\"zlucky-value\"><span class=\"zdot\" style=\"background:#5D8FE8\"></span>\ube14\ub8e8</div></div>\n        </div>\n      </div>\n      <div class=\"zcard\" style=\"--zc:#8A8A96\">\n        <div class=\"zhead\"><div class=\"zsym\">\u2651</div>\n          <div><div class=\"zname\">\uc5fc\uc18c\uc790\ub9ac</div><div class=\"zdate\">12.22-1.19</div></div></div>\n        <p class=\"ztext\">\ubb35\ubb35\ud788 \uc313\uc544\uc628 \uac8c \ud2f0\uac00 \ub098\uae30 \uc2dc\uc791\ud574\uc694. \uc131\uacfc\uac00 \ubc14\ub85c \ub208\uc5d0 \ubcf4\uc774\uc9c0 \uc54a\uc544\ub3c4 \ubc29\ud5a5\uc740 \ub9de\uc73c\ub2c8 \ud398\uc774\uc2a4\ub97c \uc720\uc9c0\ud558\uc138\uc694. \uc7ac\ubb3c\uc6b4\ub3c4 \uc11c\uc11c\ud788 \uc548\uc815\ub3fc\uc694.</p>\n        <div class=\"zlucky\">\n          <div class=\"zlucky-item\"><div class=\"zlucky-label\">\ud589\uc6b4\uc758 \uc22b\uc790</div><div class=\"zlucky-value\">8</div></div>\n          <div class=\"zlucky-item\"><div class=\"zlucky-label\">\ud589\uc6b4\uc758 \uceec\ub7ec</div><div class=\"zlucky-value\"><span class=\"zdot\" style=\"background:#8A8A96\"></span>\ucc28\ucf5c</div></div>\n        </div>\n      </div>\n      <div class=\"zcard\" style=\"--zc:#5DC8E8\">\n        <div class=\"zhead\"><div class=\"zsym\">\u2652</div>\n          <div><div class=\"zname\">\ubb3c\ubcd1\uc790\ub9ac</div><div class=\"zdate\">1.20-2.18</div></div></div>\n        <p class=\"ztext\">\uc0c8\ub85c\uc6b4 \uc0ac\ub78c, \uc0c8\ub85c\uc6b4 \uc815\ubcf4\uac00 \ub3c4\uc6c0\uc774 \ub418\ub294 \uc2dc\uae30\uc608\uc694. \ub0af\uc120 \ubaa8\uc784\uc774\ub098 \uc628\ub77c\uc778 \ucee4\ubba4\ub2c8\ud2f0\uc5d0\uc11c \uc88b\uc740 \uc778\uc5f0\uc774\ub098 \uc544\uc774\ub514\uc5b4\ub97c \uc5bb\uc744 \uc218 \uc788\uc5b4\uc694.</p>\n        <div class=\"zlucky\">\n          <div class=\"zlucky-item\"><div class=\"zlucky-label\">\ud589\uc6b4\uc758 \uc22b\uc790</div><div class=\"zlucky-value\">16</div></div>\n          <div class=\"zlucky-item\"><div class=\"zlucky-label\">\ud589\uc6b4\uc758 \uceec\ub7ec</div><div class=\"zlucky-value\"><span class=\"zdot\" style=\"background:#5DC8E8\"></span>\ud130\ucf70\uc774\uc988</div></div>\n        </div>\n      </div>\n      <div class=\"zcard\" style=\"--zc:#A8D9D9\">\n        <div class=\"zhead\"><div class=\"zsym\">\u2653</div>\n          <div><div class=\"zname\">\ubb3c\uace0\uae30\uc790\ub9ac</div><div class=\"zdate\">2.19-3.20</div></div></div>\n        <p class=\"ztext\">\uac10\uc131\uc774 \uc608\ubbfc\ud574\uc9c0\ub294 \uc2dc\uae30\uc608\uc694. \ud63c\uc790\ub9cc\uc758 \uc2dc\uac04\uc744 \ud655\ubcf4\ud558\uba74 \uc88b\uc740 \uc544\uc774\ub514\uc5b4\uac00 \ub5a0\uc62c\ub77c\uc694. \ub2e4\ub9cc \uc989\ud765\uc801\uc778 \uc9c0\ucd9c\uc740 \uba70\uce60 \ub4a4 \ud6c4\ud68c\ub85c \uc774\uc5b4\uc9c8 \uc218 \uc788\uc5b4\uc694.</p>\n        <div class=\"zlucky\">\n          <div class=\"zlucky-item\"><div class=\"zlucky-label\">\ud589\uc6b4\uc758 \uc22b\uc790</div><div class=\"zlucky-value\">3</div></div>\n          <div class=\"zlucky-item\"><div class=\"zlucky-label\">\ud589\uc6b4\uc758 \uceec\ub7ec</div><div class=\"zlucky-value\"><span class=\"zdot\" style=\"background:#A8D9D9\"></span>\ubbfc\ud2b8</div></div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"upsell\">\n      <p>\ubcc4\uc790\ub9ac \ub9d0\uace0, \ub0b4 \uc0ac\uc8fc\uc758 \ud750\ub984\ub3c4 \uad81\uae08\ud558\ub2e4\uba74?</p>\n      <a href=\"/saju/\">\ub098\uc758 \uc0ac\uc8fc\ud480\uc774 \ubcf4\ub7ec\uac00\uae30 &rarr;</a>\n    </div>\n\n  </div>\n</div>\n\n<!-- /wp:html -->\n"